<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/AccentColor</item>
        <item name="colorAccent">@color/AccentColor</item> <!-- checkboxes, text fields -->
        <item name="android:colorBackground">@color/PageBg1</item> <!-- background -->
        <item name="android:statusBarColor">@color/AccentStatusBarColor</item>
    </style>

    <style name="NoActionTheme" parent="AppTheme">
        <item name="android:statusBarColor">@color/LightStatusBarColor</item>
        <item name="android:windowLightStatusBar">@bool/lightMode</item>
    </style>


    <style name="AppTheme.Scan" parent="AppTheme">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="actionMenuTextColor">#ffffff</item>
    </style>

    <style name="DialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="LoadingDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <!-- 提醒方式设置页：分组列表样式，与「我的」里的设置项保持同一量级 -->
    <style name="WsAlertSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/text_fit_theme_second</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="WsAlertRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="WsAlertRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_fit_theme_first</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 开关本身不吃点击，让整行都是热区 -->
    <style name="WsAlertRowSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="WsAlertDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/Divider</item>
    </style>
</resources>
